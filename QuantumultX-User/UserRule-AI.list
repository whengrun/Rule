# target-client: quantumultx
  # 内容：Clash规则，AI平台相关的域名和IP地址
  # 引用：https://raw.githubusercontent.com/SukkaW/Surge/master/Source/non_ip/ai.conf
  # 引用：https://github.com/SukkaW/Surge/blob/master/Source/non_ip/apple_intelligence.conf

  # $ meta_description This file contains domains of OpenAI, Claude., Perplexity, Google Gemini, and other AI platforms. It is used for routing traffic to these services through a proxy.

